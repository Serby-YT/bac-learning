# Copy to .env.local and fill in. Never commit real values.

# Random 32+ characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the site is reached (links in emails and Google's redirect use it)
BETTER_AUTH_URL=http://localhost:3006

# SQLite file for accounts + progress (created on first start)
DATABASE_PATH=./data/bac.sqlite

# Google sign-in (optional; the button only appears when both are set).
# Google Cloud Console → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link emails over SMTP (Resend, Brevo, ...). Without it, in development
# the link is printed in the server log instead of being emailed.
SMTP_URL=
MAIL_FROM="Bac <cont@serban-photo.com>"
